{
    "manifest_version": 3,
    "name": "Impossible Extension",
    "version": "1.0",
    "description": "A mysterious extension for the Impossible Challenge",
    
    "permissions": [
        "storage",
        "tabs",
        "activeTab"
    ],
    
    "host_permissions": [
        "{{RENDER_URL}}/*"
    ],
    
    "background": {
        "service_worker": "background.js"
    },
    
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    
    "content_scripts": [
        {
            "matches": ["{{RENDER_URL}}/*"],
            "js": ["content.js"],
            "css": ["content.css"]
        }
    ],
    
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
